      "lists": [
        {
          "key": "speechGreetingLines",
          "values": [
            "\u0110\u1ea1o h\u1eefu mu\u1ed1n xem b\u1ea3o v\u1eadt g\u00ec? C\u1ee9 t\u1ef1 nhi\u00ean l\u1ef1a ch\u1ecdn.",
            "Kh\u00e1ch quan gh\u00e9 th\u0103m th\u1eadt \u0111\u00fang l\u00fac, h\u00f4m nay c\u00f3 kh\u00f4ng \u00edt h\u00e0ng t\u1ed1t.",
            "M\u1eddi ng\u00e0i xem h\u00e0ng, bi\u1ebft \u0111\u00e2u l\u1ea1i g\u1eb7p \u0111\u01b0\u1ee3c c\u01a1 duy\u00ean."
          ]
        },
        {
          "key": "speechDanDuocLines",
          "values": [
            "Linh d\u01b0\u1ee3c d\u01b0\u1ee1ng m\u1ec7nh, h\u1ed3i kh\u00ed b\u1ed3i nguy\u00ean, m\u1eddi ng\u00e0i xem qua.",
            "\u0110an d\u01b0\u1ee3c ch\u1ed7 ta t\u1eeb h\u1ea1 \u0111\u1ebfn ti\u00ean ph\u1ea9m \u0111\u1ec1u c\u00f3, ch\u1ec9 s\u1ee3 ng\u00e0i ch\u01b0a v\u1eeba \u00fd."
          ]
        },
        {
          "key": "speechPhapBaoLines",
          "values": [
            "Ph\u00e1p b\u1ea3o c\u00f3 linh, g\u1eb7p \u0111\u01b0\u1ee3c ch\u1ee7 nh\u00e2n x\u1ee9ng t\u1ea7m m\u1edbi t\u1ecfa s\u00e1ng.",
            "Ng\u00e0i c\u1ee9 nh\u00ecn k\u1ef9, ph\u00e1p b\u1ea3o h\u1ee3p tay th\u00ec uy th\u1ebf t\u1ef1 sinh."
          ]
        },
        {
          "key": "speechCongPhapLines",
          "values": [
            "C\u00f4ng ph\u00e1p tr\u1ecdng duy\u00ean, ch\u1ec9 ng\u01b0\u1eddi c\u00f3 nh\u00e3n l\u1ef1c m\u1edbi ch\u1ecdn \u0111\u00fang.",
            "T\u1ea1ng kinh c\u00e1c n\u00e0y c\u00f3 nhi\u1ec1u b\u1ea3n c\u1ed5 quy\u1ec3n, m\u1eddi ng\u00e0i thong th\u1ea3 xem."
          ]
        },
        {
          "key": "speechVatLieuLines",
          "values": [
            "Thi\u00ean t\u00e0i \u0111\u1ecba b\u1ea3o d\u00f9ng \u0111\u1ec3 luy\u1ec7n \u0111an luy\u1ec7n kh\u00ed \u0111\u1ec1u r\u1ea5t h\u1ee3p.",
            "V\u1eadt li\u1ec7u c\u00f3 linh t\u00ednh, ng\u00e0i c\u00f3 m\u1eaft nh\u00ecn h\u1eb3n s\u1ebd nh\u1eadn ra ngay."
          ]
        },
        {
          "key": "speechThucPhamLines",
          "values": [
            "M\u1ef9 th\u1ef1c linh th\u1ef1c c\u0169ng l\u00e0 con \u0111\u01b0\u1eddng d\u01b0\u1ee1ng th\u00e2n, m\u1eddi ng\u00e0i n\u1ebfm qua.",
            "Th\u1ef1c ph\u1ea9m h\u1ea1ng n\u00e0y v\u1ee5 s\u1eafc h\u01b0\u01a1ng \u0111\u1ee7 c\u1ea3, d\u00f9ng r\u1ea5t \u1ea5m d\u1ea1."
          ]
        },
        {
          "key": "speechInspectHaLines",
          "values": [
            "{0} n\u00e0y tuy l\u00e0 {1}, nh\u01b0ng d\u00f9ng \u0111\u00fang l\u00fac v\u1eabn r\u1ea5t h\u1eefu \u00edch.",
            "H\u00e0ng {1} g\u1ecdn g\u00e0ng th\u1ef1c d\u1ee5ng, r\u1ea5t h\u1ee3p d\u00f9ng l\u00fac c\u1ea7n."
          ]
        },
        {
          "key": "speechInspectTrungLines",
          "values": [
            "{0} n\u00e0y \u0111\u00e3 l\u00e0 {1}, mang theo b\u00ean m\u00ecnh c\u0169ng kh\u00e1 c\u00f3 th\u1ec3 di\u1ec7n.",
            "Ng\u00e0i ch\u1ecdn kh\u00e1 l\u1eafm, {1} nh\u01b0 th\u1ebf n\u00e0y r\u1ea5t \u0111\u00e1ng \u0111\u1ec3 xu\u1ed1ng linh th\u1ea1ch."
          ]
        },
        {
          "key": "speechInspectThuongLines",
          "values": [
            "Qu\u1ea3 nhi\u00ean ng\u00e0i c\u00f3 \u0111\u1ed9c nh\u00e3n, {0} \u0111\u00edch th\u1ef1c l\u00e0 {1}.",
            "B\u1ea3o v\u1eadt c\u1ea5p {1} nh\u01b0 {0} kh\u00f4ng ph\u1ea3i l\u00fac n\u00e0o c\u0169ng g\u1eb7p."
          ]
        },
        {
          "key": "speechInspectTienLines",
          "values": [
            "Ch\u1ec9 b\u1eadc th\u01b0\u1ee3ng kh\u00e1ch m\u1edbi d\u1eebng m\u1eaft l\u1ea1i \u1edf {0}, qu\u1ea3 nhi\u00ean l\u00e0 {1}.",
            "Ti\u00ean ph\u1ea9m c\u00f3 linh quang t\u1ef1 \u1ea9n, ng\u00e0i v\u1eeba nh\u00ecn \u0111\u00e3 nh\u1eadn ra, th\u1eadt khi\u1ebfn ng\u01b0\u1eddi kh\u00e2m ph\u1ee5c."
          ]
        },
        {
          "key": "speechBuyHaLines",
          "values": [
            "C\u1ea3m \u01a1n qu\u00fd kh\u00e1ch \u0111\u00e3 chi\u1ebfu c\u1ed1, mong {0} h\u1ee3p \u00fd ng\u00e0i.",
            "\u0110a t\u1ea1 ng\u00e0i \u0111\u00e3 \u1ee7ng h\u1ed9, d\u00f9 l\u00e0 {1} nh\u01b0ng r\u1ea5t d\u1ec5 d\u00f9ng."
          ]
        },
        {
          "key": "speechBuyTrungLines",
          "values": [
            "Ch\u00fac ng\u00e0i ph\u00e1t t\u00e0i ph\u00e1t l\u1ed9c, {0} n\u00e0y \u1eaft s\u1ebd h\u1ed7 tr\u1ee3 ng\u00e0i kh\u00f4ng \u00edt.",
            "\u0110a t\u1ea1 ng\u00e0i r\u1ed9ng tay, b\u1ea3o v\u1eadt {1} n\u00e0y v\u1ec1 tay ng\u00e0i qu\u1ea3 l\u00e0 \u0111\u00fang ch\u1ee7."
          ]
        },
        {
          "key": "speechBuyThuongLines",
          "values": [
            "Kh\u1ea9u kh\u00ed c\u1ee7a ng\u00e0i qu\u1ea3 nhi\u00ean phi ph\u00e0m, {0} v\u1ec1 tay minh ch\u1ee7 \u1eaft s\u1ebd r\u1ea1ng danh.",
            "B\u1eadc cao nh\u00e2n ra tay qu\u1ea3 c\u00f3 kh\u00e1c, m\u1ed9t l\u1ea7n \u0111\u00e3 ch\u1ecdn th\u1eb3ng h\u00e0ng {1}."
          ]
        },
        {
          "key": "speechBuyTienLines",
          "values": [
            "Ti\u00ean nh\u00e3n nh\u01b0 ng\u00e0i th\u1eadt khi\u1ebfn k\u1ebb bu\u00f4n n\u00e0y kh\u00e2m ph\u1ee5c, {0} ch\u1ec9 c\u00f3 b\u1eadc th\u01b0\u1ee3ng kh\u00e1ch m\u1edbi x\u1ee9ng s\u1edf h\u1eefu.",
            "B\u00e1u v\u1eadt {1} m\u00e0 g\u1eb7p \u0111\u01b0\u1ee3c minh ch\u1ee7 nh\u01b0 ng\u00e0i, \u0111\u00fang l\u00e0 duy\u00ean tr\u1eddi \u0111\u1ecbnh s\u1eb5n."
          ]
        }
      ]
    },
